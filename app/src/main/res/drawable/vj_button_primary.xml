<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/vj_state_paused" />
            <corners android:radius="@dimen/vj_button_radius" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vj_cyan_bright" />
            <corners android:radius="@dimen/vj_button_radius" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vj_cyan" />
            <corners android:radius="@dimen/vj_button_radius" />
        </shape>
    </item>

</selector>
