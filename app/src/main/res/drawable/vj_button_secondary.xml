<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vj_bg_surface_pressed" />
            <corners android:radius="@dimen/vj_button_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/vj_border_active" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vj_bg_surface" />
            <corners android:radius="@dimen/vj_button_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/vj_border_subtle" />
        </shape>
    </item>

</selector>
