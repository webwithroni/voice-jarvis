<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">

        <shape android:shape="rectangle">

            <solid android:color="#285CE7FF" />

            <corners
                android:radius="24dp" />

            <stroke
                android:width="1dp"
                android:color="@color/vj_cyan" />

        </shape>

    </item>

    <item>

        <shape android:shape="rectangle">

            <solid android:color="#18FFFFFF" />

            <corners
                android:radius="24dp" />

            <stroke
                android:width="1dp"
                android:color="@color/vj_border_normal" />

        </shape>

    </item>

</selector>
