<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#18222E"/>
            <corners android:radius="24dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/vj_cyan"/>
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="@color/vj_bg_surface"/>
            <corners android:radius="24dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/vj_border_normal"/>
        </shape>
    </item>

</selector>
