<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/vj_bg_canvas"

    android:paddingStart="@dimen/vj_screen_horizontal"
    android:paddingEnd="@dimen/vj_screen_horizontal"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/resetBrand"
        style="@style/VJTextTitle"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="JARVIS"
        android:letterSpacing="0.18"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/resetTitle"
        style="@style/VJTextDisplay"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="56dp"

        android:text="Reset access"
        android:textSize="30sp"
        android:textStyle="bold"

        app:layout_constraintTop_toBottomOf="@id/resetBrand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/resetSubtitle"
        style="@style/VJTextSecondary"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="10dp"

        android:text="Enter your JARVIS email and we'll send you a secure password reset link."

        app:layout_constraintTop_toBottomOf="@id/resetTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/resetEmailLayout"

        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="28dp"

        android:hint="Email"

        app:boxStrokeColor="@color/vj_cyan"
        app:hintTextColor="@color/vj_text_secondary"

        app:layout_constraintTop_toBottomOf="@id/resetSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/resetEmailInput"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/resetSendButton"

        style="@style/VJButton"

        android:layout_width="0dp"
        android:layout_height="@dimen/vj_button_height"

        android:layout_marginTop="14dp"

        android:background="@drawable/vj_button_primary"

        android:text="SEND RESET LINK"
        android:textColor="@color/vj_bg_canvas"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"

        app:layout_constraintTop_toBottomOf="@id/resetEmailLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/resetProgress"

        android:layout_width="28dp"
        android:layout_height="28dp"

        android:layout_marginTop="14dp"

        android:visibility="gone"

        app:layout_constraintTop_toBottomOf="@id/resetSendButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/resetStatus"

        style="@style/VJTextCaption"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="14dp"

        android:gravity="center"

        android:text="Your password is never shown to JARVIS."
        android:textColor="@color/vj_text_tertiary"

        app:layout_constraintTop_toBottomOf="@id/resetProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/resetBackButton"

        style="@style/VJTextCaption"

        android:layout_width="wrap_content"
        android:layout_height="48dp"

        android:gravity="center"

        android:text="Back to sign in"
        android:textColor="@color/vj_cyan"
        android:textStyle="bold"

        android:clickable="true"
        android:focusable="true"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
