<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vj_bg_canvas"
    android:paddingStart="@dimen/vj_screen_horizontal"
    android:paddingEnd="@dimen/vj_screen_horizontal"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <!-- TOP BRAND -->

    <LinearLayout
        android:id="@+id/authBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/authLogo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_jarvis_logo"
            android:contentDescription="JARVIS" />

        <TextView
            android:id="@+id/authBrandText"
            style="@style/VJTextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="JARVIS"
            android:letterSpacing="0.18" />

    </LinearLayout>

    <!-- PRODUCT POSITIONING -->

    <TextView
        android:id="@+id/authEyebrow"
        style="@style/VJTextCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="PERSONAL VOICE INTELLIGENCE"
        android:textColor="@color/vj_cyan"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        app:layout_constraintTop_toBottomOf="@id/authBrand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/authTitle"
        style="@style/VJTextDisplay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Your voice.\nYour intelligence."
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/authEyebrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/authSubtitle"
        style="@style/VJTextSecondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="A personal autonomous voice system built around you."
        android:lineSpacingExtra="3dp"
        app:layout_constraintTop_toBottomOf="@id/authTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- NEURAL ORB -->

    <FrameLayout
        android:id="@+id/authOrbStage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/authSubtitle"
        app:layout_constraintBottom_toTopOf="@id/authActionArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.webwithroni.voicejarvis.orb.HumanoidOrbView
            android:id="@+id/authOrb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="JARVIS neural orb" />

        <TextView
            android:id="@+id/authOrbLabel"
            style="@style/VJTextCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="18dp"
            android:text="NEURAL CORE"
            android:textColor="@color/vj_text_tertiary"
            android:letterSpacing="0.16" />

    </FrameLayout>

    <!-- AUTH ACTION -->

    <LinearLayout
        android:id="@+id/authActionArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/googleSignInButton"
            style="@style/VJButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vj_button_height"
            android:background="@drawable/vj_button_primary"
            android:text="Continue with Google"
            android:textColor="@color/vj_bg_canvas"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <ProgressBar
            android:id="@+id/googleSignInProgress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/authStatusText"
            style="@style/VJTextCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Secure sign-in with your Google account."
            android:textColor="@color/vj_text_tertiary" />

        <TextView
            android:id="@+id/authSecurityText"
            style="@style/VJTextCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Your account keeps your conversations and preferences synced."
            android:textColor="@color/vj_text_tertiary" />

        <TextView
            android:id="@+id/authLegalText"
            style="@style/VJTextCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Privacy  •  Terms"
            android:textColor="@color/vj_text_disabled" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
