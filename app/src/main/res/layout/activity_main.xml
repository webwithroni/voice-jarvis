<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vj_bg_canvas"
    android:clipToPadding="false"
    android:paddingStart="@dimen/vj_screen_horizontal"
    android:paddingEnd="@dimen/vj_screen_horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- ===================================================== -->
    <!-- HEADER                                                -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="@dimen/vj_icon_button_size_large"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/headerLogo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_jarvis_logo"
            android:contentDescription="Voice Jarvis" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/jarvisBrand"
                style="@style/VJTextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JARVIS"
                android:letterSpacing="0.18" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/connectionDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_avatar_jarvis" />

                <TextView
                    android:id="@+id/connectionLabel"
                    style="@style/VJTextCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="VOICE • ONLINE"
                    android:letterSpacing="0.08" />

            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/historyButton"
            android:layout_width="@dimen/vj_icon_button_size"
            android:layout_height="@dimen/vj_icon_button_size"
            android:padding="12dp"
            android:background="@drawable/vj_icon_button_background"
            android:src="@drawable/ic_history"
            android:tint="@color/vj_text_primary"
            android:contentDescription="Conversation History" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="@dimen/vj_icon_button_size"
            android:layout_height="@dimen/vj_icon_button_size"
            android:layout_marginStart="8dp"
            android:padding="12dp"
            android:background="@drawable/vj_icon_button_background"
            android:src="@drawable/ic_settings"
            android:tint="@color/vj_text_primary"
            android:contentDescription="Settings" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- PRIMARY ORB STAGE                                     -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/orbStage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toTopOf="@id/stateContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.webwithroni.voicejarvis.orb.HumanoidOrbView
            android:id="@+id/orbView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Jarvis Neural Orb" />

        <ImageView
            android:id="@+id/orbCenterIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:padding="14dp"
            android:visibility="gone"
            android:contentDescription="Jarvis status icon" />

        <!-- Small contextual label floating inside the Orb stage. -->
        <TextView
            android:id="@+id/orbModeLabel"
            style="@style/VJTextCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="18dp"
            android:text="NEURAL CORE"
            android:textColor="@color/vj_text_tertiary"
            android:letterSpacing="0.16" />

    </FrameLayout>

    <!-- ===================================================== -->
    <!-- STATE                                                -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/stateContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/contentScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/stateLabel"
            style="@style/VJStateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/vj_state_pill"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="LISTENING" />

        <TextView
            android:id="@+id/microcopy"
            style="@style/VJTextBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="I'm listening."
            android:textColor="@color/vj_text_secondary" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- CONTEXT AREA                                         -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottomDock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- THINKING -->

            <LinearLayout
                android:id="@+id/thinkingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/vj_card_background"
                android:orientation="vertical"
                android:padding="@dimen/vj_card_padding_large"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_avatar_jarvis" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="PROCESSING"
                        style="@style/VJTextCaption"
                        android:textColor="@color/vj_violet"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                </LinearLayout>

                <TextView
                    android:id="@+id/currentRequestText"
                    style="@style/VJTextBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="—"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/processStep0"
                    style="@style/VJTextSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="○  Understanding your question" />

                <TextView
                    android:id="@+id/processStep1"
                    style="@style/VJTextSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="○  Working on it" />

                <TextView
                    android:id="@+id/processStep2"
                    style="@style/VJTextSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="○  Preparing response" />

            </LinearLayout>

            <!-- PAUSED -->

            <LinearLayout
                android:id="@+id/pausedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/vj_card_background"
                android:orientation="vertical"
                android:padding="@dimen/vj_card_padding"
                android:visibility="gone">

                <TextView
                    style="@style/VJTextCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JARVIS IS PAUSED"
                    android:textColor="@color/vj_state_paused"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    style="@style/VJTextSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Resume whenever you're ready." />

            </LinearLayout>

            <!-- ERROR -->

            <LinearLayout
                android:id="@+id/tipsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/vj_card_background"
                android:orientation="vertical"
                android:padding="@dimen/vj_card_padding"
                android:visibility="gone">

                <TextView
                    style="@style/VJTextCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIDN'T CATCH THAT"
                    android:textColor="@color/vj_state_error"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    style="@style/VJTextSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Try again naturally. You can speak in English, Hindi, Bengali or Hinglish."
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- LATEST EXCHANGE -->

            <LinearLayout
                android:id="@+id/conversationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/userBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/vj_card_background"
                    android:orientation="vertical"
                    android:padding="@dimen/vj_card_padding"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/bg_avatar_user" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="YOU"
                            style="@style/VJTextCaption"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/userTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            style="@style/VJTextCaption" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/userBubble"
                        style="@style/VJTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:textColor="@color/vj_text_primary"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/jarvisBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/vj_card_background"
                    android:orientation="vertical"
                    android:padding="@dimen/vj_card_padding"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/bg_avatar_jarvis" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="JARVIS"
                            style="@style/VJTextCaption"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/jarvisTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            style="@style/VJTextCaption" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/jarvisBubble"
                        style="@style/VJTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:textColor="@color/vj_text_primary"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- DEBUG / DIAGNOSTICS -->

            <ScrollView
                android:id="@+id/debugScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/statusText"
                    style="@style/VJTextCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:lineSpacingExtra="3dp" />

            </ScrollView>

        </LinearLayout>

    </ScrollView>

    <!-- ===================================================== -->
    <!-- BOTTOM COMMAND DOCK                                  -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/quickActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/homeHistoryHint"
                style="@style/VJTextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="HISTORY"
                android:textColor="@color/vj_text_secondary"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/homeToolsHint"
                style="@style/VJTextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="TOOLS"
                android:textColor="@color/vj_text_secondary"
                android:letterSpacing="0.08" />

        </LinearLayout>

        <ImageView
            android:id="@+id/muteIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="4dp"
            android:padding="17dp"
            android:background="@drawable/vj_icon_button_background"
            android:src="@drawable/ic_mute"
            android:contentDescription="Mute Jarvis"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/muteLabel"
            style="@style/VJTextCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="MUTE"
            android:textColor="@color/vj_text_secondary"
            android:textStyle="bold"
            android:letterSpacing="0.10" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- PERMISSION TAKEOVER                                  -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/permissionCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/vj_bg_canvas"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:src="@drawable/ic_mic"
            android:padding="20dp"
            android:background="@drawable/vj_state_pill" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="MICROPHONE ACCESS NEEDED"
            style="@style/VJTextHeading"
            android:textColor="@color/vj_state_error"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Jarvis needs microphone access to hear and respond to you."
            style="@style/VJTextBody"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/enableMicButton"
            style="@style/VJButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vj_button_height"
            android:layout_marginTop="24dp"
            android:text="Enable microphone"
            android:textColor="@color/vj_bg_canvas"
            android:background="@drawable/vj_button_primary" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
