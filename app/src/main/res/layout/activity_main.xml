<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/jarvisBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JARVIS"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="Settings"
        android:src="@android:drawable/ic_menu_preferences"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/historyButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:padding="9dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="History"
        android:src="@android:drawable/ic_menu_recent_history"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/settingsButton" />

    <!-- Orb row: waveform bars flank the orb -->
    <LinearLayout
        android:id="@+id/orbRow"
        android:layout_width="0dp"
        android:layout_height="240dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/stateLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintVertical_chainStyle="packed">

        <com.webwithroni.voicejarvis.WaveformBarsView
            android:id="@+id/waveformLeft"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="240dp"
            android:layout_height="240dp">

            <com.webwithroni.voicejarvis.OrbView
                android:id="@+id/orbView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/orbCenterIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:padding="14dp"
                android:visibility="gone"
                android:contentDescription="Jarvis status icon" />
        </FrameLayout>

        <com.webwithroni.voicejarvis.WaveformBarsView
            android:id="@+id/waveformRight"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:scaleX="-1" />

    </LinearLayout>

    <TextView
        android:id="@+id/stateLabel"
        style="@style/Type.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="LISTENING"
        app:layout_constraintTop_toBottomOf="@id/orbRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/microcopy"
        style="@style/Type.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Say something."
        app:layout_constraintTop_toBottomOf="@id/stateLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrollable content area for state-specific cards -->
    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/microcopy"
        app:layout_constraintBottom_toTopOf="@id/muteIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- PAUSED state info row -->
            <LinearLayout
                android:id="@+id/pausedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Type.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tap Resume to continue" />

                <TextView
                    style="@style/Type.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Jarvis will start listening again" />
            </LinearLayout>

            <!-- ERROR tips card -->
            <LinearLayout
                android:id="@+id/tipsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Type.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="TIPS" />

                <TextView
                    style="@style/Type.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="• Speak clearly, in a calm voice" />

                <TextView
                    style="@style/Type.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="• Try not to speak too fast" />

                <TextView
                    style="@style/Type.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Reduce background noise" />
            </LinearLayout>

            <!-- THINKING processing checklist -->
            <LinearLayout
                android:id="@+id/thinkingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Type.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="CURRENT REQUEST" />

                <TextView
                    android:id="@+id/currentRequestText"
                    style="@style/Type.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="—" />

                <TextView
                    android:id="@+id/processStep0"
                    style="@style/Type.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="○  Understanding your question" />

                <TextView
                    android:id="@+id/processStep1"
                    style="@style/Type.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="○  Working on it" />

                <TextView
                    android:id="@+id/processStep2"
                    style="@style/Type.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="○  Preparing response" />
            </LinearLayout>

            <!-- Conversation preview -->
            <LinearLayout
                android:id="@+id/conversationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/userBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_bubble"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_avatar_user" />

                        <TextView
                            style="@style/Type.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="YOU" />

                        <TextView
                            android:id="@+id/userTime"
                            style="@style/Type.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/userBubble"
                        style="@style/Type.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/jarvisBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bubble"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_avatar_jarvis" />

                        <TextView
                            style="@style/Type.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="JARVIS" />

                        <TextView
                            android:id="@+id/jarvisTime"
                            style="@style/Type.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/jarvisBubble"
                        style="@style/Type.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/debugScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="300dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/statusText"
                    style="@style/Type.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- PERMISSION NEEDED full takeover -->
    <LinearLayout
        android:id="@+id/permissionCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg_canvas"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/Type.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/state_error"
            android:text="MICROPHONE ACCESS NEEDED" />

        <TextView
            style="@style/Type.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Microphone access is required for Jarvis to hear and respond to you." />

        <Button
            android:id="@+id/enableMicButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/state_error"
            android:text="ENABLE MICROPHONE"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ImageView
        android:id="@+id/muteIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="14dp"
        android:background="@drawable/bg_circle_button"
        android:src="@android:drawable/ic_lock_silent_mode"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Mute"
        app:layout_constraintBottom_toTopOf="@id/muteLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="1" />

    <TextView
        android:id="@+id/muteLabel"
        style="@style/Type.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="MUTE"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
