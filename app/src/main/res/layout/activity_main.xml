<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vj_bg_canvas"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- ===================================================== -->
    <!-- HEADER                                                -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/headerLogo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_jarvis_logo"
        android:contentDescription="Voice Jarvis"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/jarvisBrand"
        style="@style/VJTextTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="JARVIS"
        android:letterSpacing="0.18"
        app:layout_constraintStart_toEndOf="@id/headerLogo"
        app:layout_constraintTop_toTopOf="@id/headerLogo"
        app:layout_constraintBottom_toBottomOf="@id/headerLogo" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="@dimen/vj_min_touch_target"
        android:layout_height="@dimen/vj_min_touch_target"
        android:padding="12dp"
        android:background="@drawable/vj_icon_button_background"
        android:src="@drawable/ic_settings"
        android:tint="@color/vj_text_primary"
        android:contentDescription="Settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/historyButton"
        android:layout_width="@dimen/vj_min_touch_target"
        android:layout_height="@dimen/vj_min_touch_target"
        android:layout_marginEnd="10dp"
        android:padding="12dp"
        android:background="@drawable/vj_icon_button_background"
        android:src="@drawable/ic_history"
        android:tint="@color/vj_text_primary"
        android:contentDescription="Conversation History"
        app:layout_constraintEnd_toStartOf="@id/settingsButton"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===================================================== -->
    <!-- PRIMARY ORB STAGE                                    -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/orbStage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/jarvisBrand"
        app:layout_constraintBottom_toTopOf="@id/stateLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.webwithroni.voicejarvis.orb.HumanoidOrbView
            android:id="@+id/orbView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Jarvis Orb" />

        <ImageView
            android:id="@+id/orbCenterIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:padding="14dp"
            android:visibility="gone"
            android:contentDescription="Jarvis status icon" />

    </FrameLayout>

    <!-- ===================================================== -->
    <!-- STATE INDICATOR                                      -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/stateLabel"
        style="@style/VJStateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/vj_state_pill"
        android:paddingStart="14dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp"
        android:text="LISTENING"
        app:layout_constraintTop_toBottomOf="@id/orbStage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/microcopy"
        style="@style/VJTextBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="I'm listening."
        app:layout_constraintTop_toBottomOf="@id/stateLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===================================================== -->
    <!-- CONTENT                                                -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/microcopy"
        app:layout_constraintBottom_toTopOf="@id/muteIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- THINKING -->

            <LinearLayout
                android:id="@+id/thinkingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/vj_surface"
                android:orientation="vertical"
                android:padding="@dimen/vj_card_padding"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT REQUEST"
                    style="@style/VJTextCaption"
                    android:textColor="@color/vj_violet"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:id="@+id/currentRequestText"
                    style="@style/VJTextBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="—"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/processStep0"
                    style="@style/VJTextSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="○  Understanding your question"
                    android:textColor="@color/vj_text_secondary"
                    />

                <TextView
                    android:id="@+id/processStep1"
                    style="@style/VJTextSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="○  Working on it"
                    android:textColor="@color/vj_text_secondary"
                    />

                <TextView
                    android:id="@+id/processStep2"
                    style="@style/VJTextSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="○  Preparing response"
                    android:textColor="@color/vj_text_secondary"
                    />

            </LinearLayout>

            <!-- PAUSED -->

            <LinearLayout
                android:id="@+id/pausedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/vj_surface"
                android:orientation="vertical"
                android:padding="@dimen/vj_card_padding"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JARVIS IS PAUSED"
                    style="@style/VJTextCaption"
                    android:textColor="@color/vj_state_paused"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Resume whenever you're ready."

                    style="@style/VJTextSecondary" />

            </LinearLayout>

            <!-- ERROR -->

            <LinearLayout
                android:id="@+id/tipsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/vj_surface"
                android:orientation="vertical"
                android:padding="@dimen/vj_card_padding"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIDN'T CATCH THAT"
                    style="@style/VJTextCaption"
                    android:textColor="@color/vj_state_error"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Try again naturally. You can speak in English, Hindi, Bengali or Hinglish."

                    style="@style/VJTextSecondary"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- LATEST EXCHANGE -->

            <LinearLayout
                android:id="@+id/conversationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/userBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/vj_surface"
                    android:orientation="vertical"
                    android:padding="@dimen/vj_card_padding"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_avatar_user" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="YOU"
                            style="@style/VJTextCaption"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/userTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            style="@style/VJTextCaption" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/userBubble"
                        style="@style/VJTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/vj_text_primary"

                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/jarvisBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/vj_surface"
                    android:orientation="vertical"
                    android:padding="@dimen/vj_card_padding"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_avatar_jarvis" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="JARVIS"
                            style="@style/VJTextCaption"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/jarvisTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            style="@style/VJTextCaption" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/jarvisBubble"
                        style="@style/VJTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/vj_text_primary"

                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

            </LinearLayout>

            <ScrollView
                android:id="@+id/debugScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/statusText"
                    style="@style/VJTextCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:lineSpacingExtra="3dp" />

            </ScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- ===================================================== -->
    <!-- PERMISSION TAKEOVER                                  -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/permissionCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/vj_bg_canvas"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:src="@drawable/ic_mic"
            android:padding="20dp"
            android:background="@drawable/vj_state_pill" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="MICROPHONE ACCESS NEEDED"
            style="@style/VJTextHeading"
            android:textColor="@color/vj_state_error"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Jarvis needs microphone access to hear and respond to you."

            style="@style/VJTextBody"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/enableMicButton"
            style="@style/VJButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vj_button_height"
            android:layout_marginTop="24dp"
            android:text="ENABLE MICROPHONE"
            android:textColor="@color/vj_bg_canvas"
            android:background="@drawable/vj_button_primary" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- BOTTOM CONTROL                                       -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/muteIcon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:padding="16dp"
        android:background="@drawable/vj_icon_button_background"
        android:src="@drawable/ic_mute"
        android:contentDescription="Mute Jarvis"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/muteLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/muteLabel"
        style="@style/VJTextCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="MUTE"
        android:textStyle="bold"
        android:letterSpacing="0.10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
