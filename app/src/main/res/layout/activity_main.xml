<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="18dp">

    <!-- HEADER -->

    <ImageView
        android:id="@+id/headerLogo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_jarvis_logo"
        android:contentDescription="Voice Jarvis"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/jarvisBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="JARVIS"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.18"
        app:layout_constraintStart_toEndOf="@id/headerLogo"
        app:layout_constraintTop_toTopOf="@id/headerLogo"
        app:layout_constraintBottom_toBottomOf="@id/headerLogo" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:background="@drawable/vj_icon_button_background"
        android:src="@drawable/ic_settings"
        android:tint="@color/text_primary"
        android:contentDescription="Settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/historyButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="10dp"
        android:padding="12dp"
        android:background="@drawable/vj_icon_button_background"
        android:src="@drawable/ic_history"
        android:tint="@color/text_primary"
        android:contentDescription="Conversation History"
        app:layout_constraintEnd_toStartOf="@id/settingsButton"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ORB -->

    <LinearLayout
        android:id="@+id/orbRow"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/jarvisBrand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.webwithroni.voicejarvis.WaveformBarsView
            android:id="@+id/waveformLeft"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/orbContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:minWidth="240dp"
            android:minHeight="280dp"
            android:gravity="center">

            <com.webwithroni.voicejarvis.orb.HumanoidOrbView
                android:id="@+id/orbView"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:contentDescription="Jarvis Orb" />

            <ImageView
                android:id="@+id/orbCenterIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:padding="14dp"
                android:visibility="gone"
                android:contentDescription="Jarvis status icon" />

        </FrameLayout>

        <com.webwithroni.voicejarvis.WaveformBarsView
            android:id="@+id/waveformRight"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:scaleX="-1" />

    </LinearLayout>

    <!-- STATE -->

    <TextView
        android:id="@+id/stateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        android:background="@drawable/vj_state_pill"
        android:fontFamily="sans"
        android:letterSpacing="0.10"
        android:text="LISTENING"
        android:textColor="@color/accent_cyan"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/orbRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/microcopy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="I'm listening."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/stateLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CONTENT -->

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        app:layout_constraintTop_toBottomOf="@id/microcopy"
        app:layout_constraintBottom_toTopOf="@id/muteIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- THINKING -->

            <LinearLayout
                android:id="@+id/thinkingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/vj_surface"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT REQUEST"
                    android:textColor="@color/accent_violet"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:id="@+id/currentRequestText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/processStep0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="○  Understanding your question"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/processStep1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="○  Working on it"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/processStep2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="○  Preparing response"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- PAUSED -->

            <LinearLayout
                android:id="@+id/pausedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/vj_surface"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JARVIS IS PAUSED"
                    android:textColor="@color/state_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Resume whenever you're ready."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- ERROR -->

            <LinearLayout
                android:id="@+id/tipsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/vj_surface"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIDN'T CATCH THAT"
                    android:textColor="@color/state_error"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Try again naturally. You can speak in English, Hindi, Bengali or Hinglish."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- LATEST EXCHANGE -->

            <LinearLayout
                android:id="@+id/conversationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/userBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/vj_surface"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_avatar_user" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="YOU"
                            android:textColor="@color/text_tertiary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/userTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/userBubble"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/jarvisBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/vj_surface"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_avatar_jarvis" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="JARVIS"
                            android:textColor="@color/text_tertiary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/jarvisTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/jarvisBubble"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

            </LinearLayout>

            <ScrollView
                android:id="@+id/debugScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="3dp" />

            </ScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- PERMISSION TAKEOVER -->

    <LinearLayout
        android:id="@+id/permissionCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg_canvas"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:src="@drawable/ic_mic"
            android:padding="20dp"
            android:background="@drawable/vj_state_pill" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="MICROPHONE ACCESS NEEDED"
            android:textColor="@color/state_error"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Jarvis needs microphone access to hear and respond to you."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/enableMicButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="ENABLE MICROPHONE"
            android:textStyle="bold"
            android:textColor="@color/bg_canvas"
            android:background="@drawable/vj_button_primary" />

    </LinearLayout>

    <!-- MUTE -->

    <ImageView
        android:id="@+id/muteIcon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:padding="16dp"
        android:background="@drawable/vj_icon_button_background"
        android:src="@drawable/ic_mute"
        android:contentDescription="Mute Jarvis"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/muteLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/muteLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="MUTE"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
